# ========================================================
# Adaptive Study Tutor - Configuration & Environment Setup
# ========================================================

# LLM Provider selection: 'anthropic' | 'google' | 'openai'
# If not specified, the system automatically detects whichever key is present.
LLM_PROVIDER=google

# Provider API Keys (Fill at least ONE of these, or leave MOCK_LLM=true for offline mock mode)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Tavily Web Search API Key (Used strictly for supplementary web context)
TAVILY_API_KEY=your_tavily_api_key_here

# Agentic Mastery Loop Configuration
MASTERY_THRESHOLD=0.70
MAX_ITERATIONS=3

# Mock Mode: Set to 'true' to run fully offline without any API keys (all tests & demo pass)
MOCK_LLM=false

# Persistence Paths
SQLITE_DB_PATH=data/tutor_progress.db
VECTOR_STORE_PATH=data/vector_store
